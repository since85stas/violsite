---
// О себе: биография слева, блок цифр справа, под ними — лента «Сцены и фестивали».
import { type Lang, useTranslations, pick } from '../i18n/ui';
import about from '../data/about.json';
import Venues from './Venues.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const [first, ...rest] = pick(about.paragraphs, lang);
---
<section class="section" id="about">
  <div class="wrap about">
    <div class="about__text">
      <div class="eyebrow">{t('about.eyebrow')}</div>
      <h2>{pick(about.title, lang)}</h2>
      {first && <p>{first}</p>}
      {rest.length > 0 && (
        <>
          <!-- Остальная биография — под «Читать дальше». Без JS видна целиком (класс скрытия ставит скрипт). -->
          <div class="about__more" id="about-more" data-about-more>
            {rest.map((p) => <p class="muted">{p}</p>)}
          </div>
          <button type="button" class="about__toggle" aria-controls="about-more" aria-expanded="true" hidden data-about-toggle
            data-more={t('about.more')} data-less={t('about.less')}>{t('about.more')}</button>
        </>
      )}
    </div>
    <dl class="about__facts">
      {about.facts.map((f) => (
        <div class="about__fact">
          <dt>{pick(f.label, lang)}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
    <Venues lang={lang} />
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  .about__text { display: flex; flex-direction: column; gap: 16px; max-width: 60ch; min-width: 0; }
  .about__text h2 { margin-bottom: 4px; }
  .about__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 24px; align-content: start; margin: 0; }
  .about__fact { display: flex; flex-direction: column-reverse; gap: 6px; }
  .about__fact dd { margin: 0; font-family: var(--display); font-size: 38px; line-height: 1; font-variant-numeric: tabular-nums; }
  .about__fact dt { font-size: 14px; color: var(--muted); }
  .about__more { display: flex; flex-direction: column; gap: 16px; }
  .about__more.is-collapsed { display: none; }
  .about__toggle {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 8px;
    padding: 0; border: 0; background: none; font: inherit; font-size: 15px; font-weight: 500;
    color: var(--accent); cursor: pointer;
  }
  .about__toggle[hidden] { display: none; }
  .about__toggle::after {
    content: ''; width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg); transition: transform 0.2s ease;
  }
  .about__toggle[aria-expanded='true']::after { transform: translateY(2px) rotate(-135deg); }
  .about__toggle:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 820px) {
    .about { grid-template-columns: 1fr; gap: 36px; }
  }
</style>

<script>
  // «Читать дальше»: сворачиваем остальную биографию, кнопка разворачивает и сворачивает обратно
  const more = document.querySelector<HTMLElement>('[data-about-more]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-about-toggle]');
  if (more && toggle) {
    const set = (open: boolean) => {
      more.classList.toggle('is-collapsed', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = (open ? toggle.dataset.less : toggle.dataset.more) ?? '';
    };
    set(false);
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      set(open);
      // после сворачивания — вернуть кнопку в поле зрения, если текст был длинным
      if (!open) toggle.scrollIntoView({ block: 'nearest' });
    });
  }
</script>
