---
// Запись на пробный урок без сбора данных на сайте.
// Посетитель выбирает формат, день, время и кто будет заниматься — скрипт составляет текст,
// а кнопки открывают WhatsApp / Telegram с этим текстом. Отправляет сам посетитель из своего
// мессенджера; сайт ничего не принимает и не хранит.
import { type Lang, useTranslations, pick } from '../i18n/ui';
import lessons from '../data/lessons.json';
import site from '../data/site.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const { whoOptions, timeOptions, daysAhead, skipWeekdays } = lessons.form;
const c = site.contacts;

const waDigits = c.whatsapp.replace(/\D/g, '');
const tgUser = c.telegram.replace(/^@/, '');
const phoneHref = c.phone ? `tel:${c.phone.replace(/[^\d+]/g, '')}` : '';

const texts = {
  hello: t('book.msg.hello'),
  who: t('book.msg.who'),
  format: t('book.msg.format'),
  when: t('book.msg.when'),
  anyDay: t('book.anyDay'),
  copied: t('book.copied'),
  copy: t('book.copy'),
};
---
<form
  class="booking"
  id="booking"
  data-booking
  data-lang={lang}
  data-days-ahead={daysAhead}
  data-skip={JSON.stringify(skipWeekdays)}
  data-texts={JSON.stringify(texts)}
  data-wa={waDigits}
  data-tg={tgUser}
>
  <div class="booking__head">
    <h3>{t('book.title')}</h3>
    <p class="booking__intro">{t('book.intro')}</p>
  </div>

  <fieldset class="field">
    <legend class="field__label">{t('book.format')}</legend>
    <div class="seg">
      <input type="radio" name="format" id="fmt-offline" value={t('book.offline')} checked />
      <label for="fmt-offline">{t('book.offline')}</label>
      <input type="radio" name="format" id="fmt-online" value={t('book.online')} />
      <label for="fmt-online">{t('book.online')}</label>
    </div>
  </fieldset>

  <fieldset class="field">
    <legend class="field__label">{t('book.day')}</legend>
    <div class="days" data-days>
      <input type="radio" name="day" id="day-any" value="" checked />
      <label for="day-any" class="days__any">{t('book.anyDay')}</label>
    </div>
  </fieldset>

  <fieldset class="field">
    <legend class="field__label">{t('book.time')}</legend>
    <div class="chips">
      {timeOptions.map((o, i) => (
        <>
          <input type="radio" name="time" id={`time-${o.value}`} value={pick(o.label, lang)} checked={i === 0} />
          <label for={`time-${o.value}`}>{pick(o.label, lang)}</label>
        </>
      ))}
    </div>
  </fieldset>

  <label class="field">
    <span class="field__label">{t('book.who')}</span>
    <select name="who" id="book-who">
      {whoOptions.map((o) => <option value={pick(o.label, lang)}>{pick(o.label, lang)}</option>)}
    </select>
  </label>

  <div class="field">
    <span class="field__label" id="book-preview-label">{t('book.preview')}</span>
    <output class="booking__preview" aria-labelledby="book-preview-label" aria-live="polite" data-preview></output>
  </div>

  <div class="booking__actions">
    {waDigits && (
      <a class="btn btn--primary" href={`https://wa.me/${waDigits}`} target="_blank" rel="noopener" data-send="whatsapp" data-goal="lesson_whatsapp">
        {t('book.whatsapp')}
      </a>
    )}
    {tgUser && (
      <a class:list={['btn', !waDigits && 'btn--primary']} href={`https://t.me/${tgUser}`} target="_blank" rel="noopener" data-send="telegram" data-goal="lesson_telegram">
        {t('book.telegram')}
      </a>
    )}
    <button class="btn btn--ghost" type="button" data-copy data-goal="lesson_copy">{t('book.copy')}</button>
  </div>

  {phoneHref && (
    <p class="booking__call">{t('book.call')}: <a href={phoneHref} data-goal="lesson_call">{c.phone}</a></p>
  )}
  <p class="booking__note">{t('book.note')} {t('book.privacy')}</p>
</form>

<style>
  .booking {
    background: var(--bg); color: var(--ink); border-radius: 14px; padding: 28px;
    display: flex; flex-direction: column; gap: 18px; min-width: 0;
  }
  .booking h3 { color: var(--ink) !important; }
  .booking__head { display: flex; flex-direction: column; gap: 6px; }
  .booking__intro { font-size: 14px; color: var(--muted); }
  .field { display: flex; flex-direction: column; gap: 6px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .field__label { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); padding: 0; margin-bottom: 2px; }
  select {
    font: inherit; font-size: 15px; padding: 11px 12px; border-radius: 6px;
    border: 1px solid var(--line); background: var(--bg); color: var(--ink); width: 100%;
  }

  .seg { display: flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; gap: 3px; }
  .seg input, .chips input, .days :global(input) { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .seg label { flex: 1; text-align: center; padding: 8px 10px; border-radius: 999px; cursor: pointer; font-size: 14px; color: var(--muted); }
  .seg input:checked + label { background: var(--accent); color: var(--accent-ink); }

  .days { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
  .days :global(label) {
    flex: 0 0 auto; min-width: 62px; padding: 8px 6px; border-radius: 8px; border: 1px solid var(--line);
    text-align: center; font-size: 13px; line-height: 1.3; cursor: pointer; color: var(--muted);
  }
  .days :global(label b) { display: block; font-size: 17px; font-weight: 500; color: var(--ink); font-variant-numeric: tabular-nums; }
  .days .days__any { display: flex; align-items: center; padding-inline: 12px; color: var(--ink); }
  .days :global(input:checked + label) { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips label { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); font-size: 14px; cursor: pointer; }
  .chips input:checked + label { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .seg input:focus-visible + label, .chips input:focus-visible + label, .days :global(input:focus-visible + label) {
    outline: 2px solid var(--accent); outline-offset: 2px;
  }

  .booking__preview {
    display: block; white-space: pre-line; font-size: 14px; line-height: 1.55;
    padding: 12px 14px; border-radius: 10px; background: var(--soft); border: 1px solid var(--line);
  }
  .booking__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn--ghost { border-color: var(--line); color: var(--muted); }
  .btn--ghost:hover { color: var(--ink); }
  .booking__call { font-size: 14px; }
  .booking__call a { color: var(--accent); white-space: nowrap; }
  .booking__note { font-size: 13px; color: var(--muted); }
  @media (max-width: 520px) {
    .booking { padding: 20px; }
    .booking__actions .btn { flex: 1 1 100%; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-booking]');

  if (form) {
    const lang = form.dataset.lang === 'en' ? 'en' : 'ru';
    const locale = lang === 'ru' ? 'ru-RU' : 'en-GB';
    const tx = JSON.parse(form.dataset.texts ?? '{}') as Record<string, string>;
    const daysAhead = Number(form.dataset.daysAhead ?? 14);
    const skip = JSON.parse(form.dataset.skip ?? '[]') as number[];
    const preview = form.querySelector<HTMLElement>('[data-preview]')!;
    const copyBtn = form.querySelector<HTMLButtonElement>('[data-copy]')!;

    // Дни: с завтрашнего на daysAhead вперёд, без выходных из skipWeekdays
    const daysBox = form.querySelector<HTMLElement>('[data-days]')!;
    const wd = new Intl.DateTimeFormat(locale, { weekday: 'short' });
    const mon = new Intl.DateTimeFormat(locale, { month: 'short' });
    const full = new Intl.DateTimeFormat(locale, { weekday: 'short', day: 'numeric', month: 'long' });
    const today = new Date();
    for (let i = 1; i <= daysAhead; i++) {
      const d = new Date(today.getFullYear(), today.getMonth(), today.getDate() + i);
      if (skip.includes(d.getDay())) continue;
      const id = `day-${i}`;
      const input = Object.assign(document.createElement('input'), { type: 'radio', name: 'day', id, value: full.format(d) });
      const label = document.createElement('label');
      label.htmlFor = id;
      label.innerHTML = `${wd.format(d).replace('.', '')}<b>${d.getDate()}</b>${mon.format(d).replace('.', '')}`;
      daysBox.append(input, label);
    }

    const value = (name: string) => String(new FormData(form).get(name) ?? '');
    const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);

    const message = () => {
      // день — как отформатировал браузер («чт, 12 ноября» / «Thu, 12 November»), остальное со строчной
      const when = [value('day') || lower(tx.anyDay), lower(value('time'))].join(', ');
      return [
        tx.hello,
        `${tx.who}: ${lower(value('who'))}`,
        `${tx.format}: ${lower(value('format'))}`,
        `${tx.when}: ${when}`,
      ].join('\n');
    };

    // Ссылки мессенджеров с готовым текстом
    const update = () => {
      const text = message();
      preview.textContent = text;
      const enc = encodeURIComponent(text);
      form.querySelectorAll<HTMLAnchorElement>('[data-send]').forEach((a) => {
        a.href = a.dataset.send === 'whatsapp'
          ? `https://wa.me/${form.dataset.wa}?text=${enc}`
          : `https://t.me/${form.dataset.tg}?text=${enc}`;
      });
    };
    form.addEventListener('change', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    update();

    // Копирование текста — на случай, если мессенджер не подставит его сам
    copyBtn.addEventListener('click', async () => {
      const text = message();
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(preview);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        document.execCommand?.('copy');
      }
      copyBtn.textContent = tx.copied;
      setTimeout(() => (copyBtn.textContent = tx.copy), 2000);
    });

    // TODO (этап 7): цели Яндекс.Метрики по data-goal (клик по WhatsApp / Telegram / копированию / звонку)
  }
</script>
