---
import { type Lang, useTranslations, localizePath, pick } from '../i18n/ui';
import site from '../data/site.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__inner">
    <span>© {year} {pick(site.name, lang)}</span>
    <a href={localizePath('/privacy', lang)}>{t('footer.privacy')}</a>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-block: 28px; font-size: 13px; color: var(--muted); }
  .footer__inner { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
</style>
