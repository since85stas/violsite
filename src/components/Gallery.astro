---
// Галерея: фильтры по категориям, сетка карточек разного размера, полноэкранный просмотр.
// Фото и подписи — src/assets/gallery/ + src/data/gallery.json.
import { type Lang, useTranslations, pick } from '../i18n/ui';
import { loadGallery, type GalleryCategory } from '../lib/gallery';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const photos = await loadGallery();
const used = new Set(photos.map((p) => p.category));
const filters = (['all', 'concert', 'lessons', 'portrait'] as const).filter(
  (f) => f === 'all' || used.has(f as GalleryCategory),
);
const categoryName = (c: GalleryCategory) => t(`gallery.${c}`);
---
{photos.length > 0 && (
  <section class="section" id="gallery">
    <div class="wrap">
      <div class="gallery-head">
        <div class="sec-head">
          <div class="eyebrow">{t('gallery.eyebrow')}</div>
          <h2>{t('gallery.title')}</h2>
        </div>
        {filters.length > 2 && (
          <div class="gallery-filters" role="group" aria-label={t('gallery.filter')} data-gallery-filters>
            {filters.map((f, i) => (
              <button type="button" class="chip" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>
                {t(`gallery.${f}`)}
              </button>
            ))}
          </div>
        )}
      </div>

      <ul class="gallery" data-gallery>
        {photos.map((p, i) => (
          <li class:list={['gallery__item', p.size && `gallery__item--${p.size}`]} data-category={p.category}>
            <button
              type="button"
              class="gallery__open"
              data-index={i}
              data-full={p.full}
              data-caption={pick(p.caption, lang)}
              data-meta={[pick(p.meta, lang), categoryName(p.category)].filter(Boolean).join(' · ')}
              aria-label={`${t('gallery.open')}: ${pick(p.caption, lang)}`}
            >
              <img src={p.thumb} srcset={p.thumbSrcset} sizes="(max-width: 820px) 50vw, 25vw" alt={pick(p.caption, lang)} loading="lazy" decoding="async" />
              <span class="gallery__caption" aria-hidden="true">{pick(p.caption, lang)}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <dialog class="lightbox" aria-label={t('gallery.viewer')} data-lightbox>
      <button class="lightbox__btn lightbox__close" type="button" data-close aria-label={t('gallery.close')}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" /></svg>
      </button>
      <button class="lightbox__btn lightbox__prev" type="button" data-prev aria-label={t('gallery.prev')}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </button>
      <figure class="lightbox__figure">
        <img class="lightbox__img" alt="" data-lb-img />
        <figcaption class="lightbox__caption">
          <span data-lb-caption></span>
          <small><span data-lb-meta></span> · <span data-lb-counter></span></small>
        </figcaption>
      </figure>
      <button class="lightbox__btn lightbox__next" type="button" data-next aria-label={t('gallery.next')}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </button>
    </dialog>
  </section>
)}

<style>
  .gallery-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .gallery-head .sec-head { margin-bottom: 0; }
  .gallery-filters { display: flex; gap: 6px; flex-wrap: wrap; }
  .chip {
    padding: 8px 16px; border-radius: 999px; border: 1px solid var(--line);
    background: transparent; color: var(--muted); font: inherit; font-size: 14px; cursor: pointer;
  }
  .chip:hover { color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }

  .gallery {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 190px; grid-auto-flow: dense; gap: 12px;
  }
  .gallery__item { border-radius: 4px; overflow: hidden; background: var(--soft); }
  .gallery__item[hidden] { display: none; }
  .gallery__item--tall { grid-row: span 2; }
  .gallery__item--wide { grid-column: span 2; }
  .gallery__open { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .gallery__open img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .gallery__open:hover img { transform: scale(1.03); }
  .gallery__caption {
    position: absolute; inset: auto 0 0; padding: 28px 12px 10px; text-align: left;
    font-size: 13px; color: #fff; background: linear-gradient(to top, rgb(0 0 0 / 0.6), transparent);
  }
  @media (max-width: 820px) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 150px; }
  }

  /* Полноэкранный просмотр: всегда тёмный, независимо от темы сайта */
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; border: 0;
    padding: calc(56px + env(safe-area-inset-top, 0px)) max(72px, env(safe-area-inset-right, 0px)) calc(24px + env(safe-area-inset-bottom, 0px)) max(72px, env(safe-area-inset-left, 0px));
    background: rgb(12 11 10 / 0.95); color: #f0ebe3;
  }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.6); }
  .lightbox__figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 14px; max-width: 100%; max-height: 100%; }
  .lightbox__img { max-width: 100%; max-height: calc(100dvh - 180px); object-fit: contain; border-radius: 2px; }
  .lightbox__caption { text-align: center; font-size: 15px; max-width: 60ch; }
  .lightbox__caption small { display: block; margin-top: 2px; font-size: 13px; color: #a69e92; }
  .lightbox__btn {
    position: absolute; width: 44px; height: 44px; border-radius: 50%; border: 0;
    display: grid; place-items: center; cursor: pointer;
    background: rgb(255 255 255 / 0.1); color: #fff;
  }
  .lightbox__btn:hover { background: rgb(255 255 255 / 0.22); }
  .lightbox__btn:focus-visible { outline: 2px solid #e2a263; outline-offset: 2px; }
  .lightbox__close { top: calc(12px + env(safe-area-inset-top, 0px)); right: max(12px, env(safe-area-inset-right, 0px)); }
  .lightbox__prev { left: max(14px, env(safe-area-inset-left, 0px)); top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: max(14px, env(safe-area-inset-right, 0px)); top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .lightbox { padding-left: max(12px, env(safe-area-inset-left, 0px)); padding-right: max(12px, env(safe-area-inset-right, 0px)); padding-bottom: calc(84px + env(safe-area-inset-bottom, 0px)); }
    .lightbox__prev, .lightbox__next { top: auto; transform: none; bottom: calc(20px + env(safe-area-inset-bottom, 0px)); }
    .lightbox__prev { left: calc(50% - 56px); }
    .lightbox__next { right: calc(50% - 56px); }
  }
  @media (prefers-reduced-motion: reduce) { .gallery__open img { transition: none; } }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (grid && dialog) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.gallery__item'));
    const buttons = items.map((li) => li.querySelector<HTMLButtonElement>('.gallery__open')!);
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const meta = dialog.querySelector<HTMLElement>('[data-lb-meta]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
    let current = 0;
    let opener: HTMLElement | null = null;

    // Фильтры
    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-filters] [data-filter]'));
    filterBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((li) => (li.hidden = !(f === 'all' || li.dataset.category === f)));
      }),
    );

    // Просмотр листает только видимые (с учётом фильтра) фото
    const visible = () => buttons.filter((_, i) => !items[i].hidden);

    const show = (btn: HTMLButtonElement) => {
      const list = visible();
      current = list.indexOf(btn);
      img.src = btn.dataset.full ?? '';
      img.alt = btn.dataset.caption ?? '';
      caption.textContent = btn.dataset.caption ?? '';
      meta.textContent = btn.dataset.meta ?? '';
      counter.textContent = `${current + 1} / ${list.length}`;
      // заранее подгружаем соседние фото
      [list[current + 1], list[current - 1]].forEach((b) => b && (new Image().src = b.dataset.full ?? ''));
    };
    const step = (d: number) => {
      const list = visible();
      show(list[(current + d + list.length) % list.length]);
    };

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        opener = btn;
        show(btn);
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      }),
    );

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      img.removeAttribute('src');
      opener?.focus();
    });
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => step(-1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => step(1));
    // клик по тёмному фону вокруг фото закрывает просмотр
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });

    // свайп на телефоне
    let startX: number | null = null;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
      startX = null;
    });
  }
</script>
