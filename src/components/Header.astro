---
// Шапка: логотип, якорное меню, переключатель языка, кнопка записи.
// Закреплена сверху при прокрутке. До 900px меню прячется в бургер.
import { type Lang, useTranslations, localizePath, pick } from '../i18n/ui';
import site from '../data/site.json';
import { allVideos } from '../lib/video';
import { hasGalleryPhotos } from '../lib/gallery';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const t = useTranslations(lang);
const home = localizePath('/', lang);
const otherLang: Lang = lang === 'ru' ? 'en' : 'ru';
const otherHref = localizePath(path, otherLang);

const links = [
  ['about', t('nav.about')],
  ['concerts', t('nav.concerts')],
  ['media', t('nav.media')],
  ['gallery', t('nav.gallery')],
  ['lessons', t('nav.lessons')],
  ['organizers', t('nav.organizers')],
].filter(([id]) => (id !== 'media' || allVideos.length > 0) && (id !== 'gallery' || hasGalleryPhotos()));
---
<header class="header" data-header>
  <div class="wrap header__inner">
    <a class="header__logo" href={home}>{pick(site.name, lang)}</a>

    <nav class="header__nav" id="site-nav" aria-label={t('nav.menu')} data-nav>
      <ul class="header__links">
        {links.map(([id, label]) => <li><a href={`${home}#${id}`}>{label}</a></li>)}
      </ul>
      <div class="header__mobile-extra">
        <a class="btn btn--primary" href={`${home}#lessons`}>{t('nav.book')}</a>
        <a class="header__lang-full" href={otherHref} hreflang={otherLang} lang={otherLang}>{t('lang.switch')}</a>
      </div>
    </nav>

    <div class="header__actions">
      <a class="header__lang" href={otherHref} hreflang={otherLang} lang={otherLang} aria-label={t('lang.switch')}>
        {otherLang.toUpperCase()}
      </a>
      <a class="btn btn--primary header__cta" href={`${home}#lessons`}>{t('nav.book')}</a>
      <button class="header__burger" type="button" aria-controls="site-nav" aria-expanded="false" data-burger>
        <span class="sr-only">{t('nav.menu')}</span>
        <span class="header__burger-lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  body::before {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: env(safe-area-inset-top, 0px);
    z-index: 51;
    background: var(--bg);
  }
  .header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner { display: flex; align-items: center; gap: 24px; min-height: var(--header-h); }
  .header__logo { font-family: var(--display); font-size: 20px; text-decoration: none; white-space: nowrap; margin-right: auto; }

  .header__links { display: flex; gap: 22px; list-style: none; margin: 0; padding: 0; font-size: 14px; }
  .header__links a, .header__lang { text-decoration: none; color: var(--muted); }
  .header__links a:hover, .header__lang:hover { color: var(--ink); }
  .header__mobile-extra { display: none; }

  .header__actions { display: flex; align-items: center; gap: 16px; font-size: 14px; }
  .header__lang { font-weight: 500; letter-spacing: 0.06em; padding: 6px 2px; }
  .header__cta { padding: 8px 16px; font-size: 14px; }

  .header__burger {
    display: none;
    width: 44px; height: 44px; margin-right: -10px;
    border: 0; background: transparent; color: var(--ink); cursor: pointer;
    align-items: center; justify-content: center;
  }
  .header__burger-lines,
  .header__burger-lines::before,
  .header__burger-lines::after {
    display: block; width: 22px; height: 1.5px; background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .header__burger-lines { position: relative; }
  .header__burger-lines::before, .header__burger-lines::after { content: ''; position: absolute; left: 0; }
  .header__burger-lines::before { top: -7px; }
  .header__burger-lines::after { top: 7px; }
  .header__burger[aria-expanded='true'] .header__burger-lines { background: transparent; }
  .header__burger[aria-expanded='true'] .header__burger-lines::before { transform: translateY(7px) rotate(45deg); background: var(--ink); }
  .header__burger[aria-expanded='true'] .header__burger-lines::after { transform: translateY(-7px) rotate(-45deg); background: var(--ink); }

  @media (max-width: 900px) {
    .header__burger { display: inline-flex; }
    .header__nav {
      position: absolute; left: 0; right: 0; top: 100%;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      padding: 8px max(var(--gutter), env(safe-area-inset-right, 0px)) 24px max(var(--gutter), env(safe-area-inset-left, 0px));
      max-height: calc(100dvh - var(--header-h) - env(safe-area-inset-top, 0px));
      overflow-y: auto;
      display: none;
    }
    .header__nav.is-open { display: block; }
    .header__links { flex-direction: column; gap: 0; font-size: 18px; }
    .header__links a { display: block; padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--ink); }
    .header__mobile-extra { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 20px; }
    .header__lang-full { color: var(--muted); text-decoration: none; }
  }
  @media (max-width: 520px) {
    .header__cta { display: none; }
    .header__logo { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .header__burger-lines, .header__burger-lines::before, .header__burger-lines::after { transition: none; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (burger && nav) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };

    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));

    // Закрыть меню после перехода по ссылке
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Закрыть по Esc и вернуть фокус на кнопку
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });

    // Закрыть при клике вне шапки
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-header]')) setOpen(false);
    });

    // При расширении окна до десктопа меню сбрасывается
    window.matchMedia('(min-width: 901px)').addEventListener('change', (mq) => {
      if (mq.matches) setOpen(false);
    });
  }
</script>
