---
// Первый экран: заголовок, лид, две кнопки, ближайший концерт, портрет.
// TODO (этап 3): портрет через <Image> из src/assets/portrait/, вёрстка из прототипа.
import { type Lang, useTranslations, pick } from '../i18n/ui';
import site from '../data/site.json';
import type { Concert } from '../lib/concerts';

interface Props { lang: Lang; next?: Concert }
const { lang, next } = Astro.props;
const t = useTranslations(lang);
---
<section class="section hero">
  <div class="wrap">
    <div class="eyebrow">{t('hero.eyebrow')}</div>
    <h1>{pick(site.tagline, lang)}</h1>
    <p class="muted">{pick(site.lead, lang)}</p>
    <p>
      <a class="btn btn--primary" href="#lessons">{t('hero.ctaLessons')}</a>
      <a class="btn" href="#concerts">{t('hero.ctaConcerts')}</a>
    </p>
    {next && <p class="muted">{t('hero.next')}: {next.date}, {next.city}, {next.venue}</p>}
  </div>
</section>
