---
// Первый экран во всю ширину: портрет у левого края на продолженном студийном фоне; справа подпись, имя, лид, кнопки, ближайший концерт.
// Портрет — первый файл из src/assets/portrait/ (jpg/png/webp). Нет файла — заглушка.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { type Lang, useTranslations, pick } from '../i18n/ui';
import site from '../data/site.json';
import type { Concert } from '../lib/concerts';
import { demoPortrait, unsplashUrl, unsplashSrcset } from '../lib/demo-photos';

interface Props { lang: Lang; next?: Concert }
const { lang, next } = Astro.props;
const t = useTranslations(lang);
const name = pick(site.name, lang);

// Быстрая запись: ссылки сразу открывают мессенджер с готовой фразой; отправляет сам посетитель.
const quickMsg = encodeURIComponent(t('hero.quickMsg'));
const waDigits = site.contacts.whatsapp.replace(/\D/g, '');
const tgUser = site.contacts.telegram.replace(/^@/, '');

const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait/*.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;

const nextDate = next
  ? new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'en-GB', { day: 'numeric', month: 'long' })
      .format(new Date(`${next.date}T12:00:00`))
  : '';
---
<section class="hero">
  <div class="hero__photo">
    {portrait ? (
      <Image
        src={portrait}
        alt={name}
        widths={[480, 720, 960, 1280]}
        sizes="(max-width: 899px) 100vw, 56vw"
        loading="eager"
        fetchpriority="high"
      />
    ) : demoPortrait ? (
      <img
        src={unsplashUrl(demoPortrait.id, 960)}
        srcset={unsplashSrcset(demoPortrait.id, [480, 720, 960, 1280])}
        sizes="(max-width: 899px) 100vw, 56vw"
        alt={name}
        fetchpriority="high"
      />
    ) : (
      <div class="hero__placeholder" role="img" aria-label={name}>
        <svg viewBox="0 0 100 220" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <path d="M50 4v58" /><rect x="45" y="2" width="10" height="16" rx="5" />
          <path d="M50 62c-16 0-26 10-26 24 0 9 6 14 6 20s-10 12-10 30c0 26 16 44 30 44s30-18 30-44c0-18-10-24-10-30s6-11 6-20c0-14-10-24-26-24z" />
          <path d="M38 118c-4 6-4 12 0 18M62 118c4 6 4 12 0 18" /><path d="M42 160h16" /><path d="M47 62v98M53 62v98" />
        </svg>
      </div>
    )}
  </div>

  <div class="wrap hero__inner">
    <div class="hero__text">
      <div class="eyebrow">{t('hero.eyebrow')}</div>
      <h1 class="hero__name">{name}</h1>
      <p class="hero__tagline">{pick(site.tagline, lang)}</p>
      <p class="hero__lead">{pick(site.lead, lang)}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#lessons">{t('hero.ctaLessons')}</a>
        <a class="btn" href="#concerts">{t('hero.ctaConcerts')}</a>
      </div>
      {(waDigits || tgUser) && (
        <div class="hero__quick">
          <span>{t('hero.quick')}</span>
          {waDigits && (
            <a class="hero__msgr" href={`https://wa.me/${waDigits}?text=${quickMsg}`} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/></svg>
              WhatsApp
            </a>
          )}
          {tgUser && (
            <a class="hero__msgr" href={`https://t.me/${tgUser}?text=${quickMsg}`} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.8-3.6-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2L6.5 13.1 1.8 11.6c-1-.3-1-1 .2-1.5l18.5-7.1c.9-.3 1.6.2 1.4 1.3Z"/></svg>
              Telegram
            </a>
          )}
        </div>
      )}
      {next && (
        <a class="hero__next" href="#concerts" data-hero-next={next.date}>
          <span class="eyebrow hero__next-label"><span class="hero__dot" aria-hidden="true"></span>{t('hero.next')}</span>
          <span><strong>{nextDate}</strong> · {next.city}, {next.venue}</span>
        </a>
      )}
    </div>
  </div>
</section>

<script>
  // Сайт пересобирается не каждый день: если «ближайший» концерт уже прошёл — прячем строку.
  const nextLink = document.querySelector<HTMLElement>('[data-hero-next]');
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Moscow' }).format(new Date());
  if (nextLink && (nextLink.dataset.heroNext ?? '') < today) nextLink.hidden = true;
</script>

<style>
  /* Первый экран во всю ширину. Фото — у левого края, его студийный фон продолжен цветом
     на всю ширину (--hero-top → --hero-bottom сняты с правого края фото), текст — на этом фоне справа.
     Фон светлый в обеих темах, поэтому цвета текста здесь свои. */
  .hero {
    --hero-top: #beadb7;
    --hero-mid: #b7aab3;
    --hero-bottom: #a99ca5;
    --ink: #221f1b;
    --muted: #3b3337;
    --line: color-mix(in srgb, #221f1b 18%, transparent);
    --soft: color-mix(in srgb, #ffffff 30%, transparent);
    --accent: #a0561b;
    --accent-ink: #ffffff;
    --hero-h: clamp(600px, calc(100svh - var(--header-h)), 860px);
    --photo-w: min(56vw, var(--hero-h));
    position: relative;
    overflow: hidden;
    color: var(--ink);
    background: linear-gradient(to bottom, var(--hero-top), var(--hero-mid) calc(var(--hero-h) / 2), var(--hero-bottom) var(--hero-h));
    background-color: var(--hero-bottom);
  }
  .hero__photo {
    position: absolute; left: 0; top: 0;
    width: var(--photo-w); height: var(--hero-h);
    /* Правый и нижний край растворяются в фоне. Справа переход узкий: цвет фона снят с края фото,
       а завиток скрипки — в 4% от края */
    -webkit-mask-image: linear-gradient(to right, #000 96%, transparent), linear-gradient(to bottom, #000 88%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, #000 96%, transparent), linear-gradient(to bottom, #000 88%, transparent);
    mask-composite: intersect;
  }
  /* Кадр уже квадрата (на узких экранах) — режем слева, где только волосы и фон: справа завиток скрипки */
  .hero__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 88% 20%; display: block; }

  .hero__inner { position: relative; display: flex; justify-content: flex-end; align-items: center; min-height: var(--hero-h); }
  .hero__text {
    min-width: 0; padding-block: 48px;
    /* Слева — зазор от завитка скрипки у края фото */
    width: min(520px, calc(100vw - var(--photo-w) - var(--gutter) - 64px));
  }
  .hero .eyebrow { color: var(--muted); }
  /* Имя — главный заголовок: крупнее и в акцентном цвете (на светлом фоне — темнее, для контраста); фраза — подзаголовок */
  .hero__name {
    margin-top: 16px;
    font-size: clamp(48px, 6.4vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: #6e340b;
  }
  .hero__tagline {
    margin-top: 14px;
    font-family: var(--display);
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.2;
    text-wrap: balance;
  }
  .hero__lead { font-size: 18px; color: var(--muted); max-width: 34ch; margin-top: 16px; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero__quick { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-top: 18px; font-size: 15px; color: var(--muted); }
  .hero__msgr {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--line); color: var(--ink); text-decoration: none; font-size: 15px;
  }
  .hero__msgr:hover { background: var(--soft); }
  .hero__msgr svg { width: 18px; height: 18px; color: var(--accent); }
  .hero__next {
    margin-top: 32px; padding-top: 18px; border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline;
    font-size: 15px; text-decoration: none; color: var(--ink);
  }
  .hero__next[hidden] { display: none; }
  .hero__next strong { font-weight: 500; }
  .hero__next-label { display: inline-flex; align-items: center; gap: 10px; }
  /* Пульсирующая точка привлекает внимание к ближайшему концерту. Без анимации — просто точка. */
  .hero__dot {
    position: relative; flex: none; width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
  }
  .hero__dot::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    background: var(--accent); animation: hero-pulse 2s ease-out infinite;
  }
  @keyframes hero-pulse {
    from { transform: scale(1); opacity: 0.6; }
    to { transform: scale(3); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__dot::after { animation: none; opacity: 0; } }
  .hero__next:hover span:last-child { text-decoration: underline; text-underline-offset: 3px; }

  /* Анимации фото. Только отдельные свойства animation-*: сокращённое animation минификатор
     сборки склеивает с animation-timeline и выбрасывает оба (в dev-режиме этого не видно).
     1) Проявление при загрузке: из лёгкой дымки и чуть крупнее — в обычный кадр.
        Двигает свойство scale, а параллакс — transform, поэтому они не мешают друг другу. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__photo :global(img) {
      animation-name: hero-intro;
      animation-duration: 1.6s;
      animation-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1);
      animation-fill-mode: both;
    }
  }
  @keyframes hero-intro {
    from { opacity: 0; scale: 1.06; filter: blur(10px); }
    to { opacity: 1; scale: 1; filter: blur(0); }
  }

  /* 2) Параллакс: при прокрутке вниз фото чуть отстаёт (scroll-driven animations).
     Маска — на рамке, поэтому края остаются растворёнными, пока фото сдвигается.
     Где браузер не умеет (Firefox), на телефоне и при «уменьшить движение» — фото просто стоит. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 900px) {
      .hero__photo { view-timeline: --hero-photo block; }
      .hero__photo :global(img) {
        animation-name: hero-intro, hero-parallax;
        animation-duration: 1.6s, auto;
        animation-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1), linear;
        animation-fill-mode: both, both;
        animation-timeline: auto, --hero-photo;
        animation-range: normal, exit 0% exit 100%;
        transform-origin: 50% 0;
      }
    }
  }
  @keyframes hero-parallax {
    from { transform: translateY(0); }
    to { transform: translateY(12%); }
  }
  .hero__placeholder { width: 100%; height: 100%; display: grid; place-items: center; color: var(--muted); }
  .hero__placeholder svg { width: 40%; height: auto; opacity: 0.5; }

  /* Телефон и узкий планшет: фото во всю ширину сверху, текст — под ним на том же фоне */
  @media (max-width: 899px) {
    .hero { --photo-w: 100%; background: linear-gradient(to bottom, var(--hero-top), var(--hero-mid) 50%, var(--hero-bottom)); }
    .hero__photo {
      position: relative; width: 100%; height: auto; aspect-ratio: 1 / 1; max-height: 70svh;
      -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent);
      mask-image: linear-gradient(to bottom, #000 80%, transparent);
    }
    .hero__inner { display: block; min-height: 0; margin-top: -12px; }
    .hero__text { width: auto; padding-block: 0 48px; }
    .hero__name { font-size: clamp(40px, 11vw, 64px); }
    .hero__lead { font-size: 17px; }
  }
  /* На телефоне подпись — отдельной строкой, а обе кнопки мессенджеров — рядом под ней */
  @media (max-width: 520px) {
    .hero__quick > span:first-child { flex-basis: 100%; }
  }
</style>
