---
// Первый экран: подпись, заголовок, лид, две кнопки, ближайший концерт, портрет.
// Портрет — первый файл из src/assets/portrait/ (jpg/png/webp). Нет файла — заглушка.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { type Lang, useTranslations, pick } from '../i18n/ui';
import site from '../data/site.json';
import type { Concert } from '../lib/concerts';
import { demoPortrait, unsplashUrl, unsplashSrcset } from '../lib/demo-photos';

interface Props { lang: Lang; next?: Concert }
const { lang, next } = Astro.props;
const t = useTranslations(lang);
const name = pick(site.name, lang);

// Быстрая запись: ссылки сразу открывают мессенджер с готовой фразой; отправляет сам посетитель.
const quickMsg = encodeURIComponent(t('hero.quickMsg'));
const waDigits = site.contacts.whatsapp.replace(/\D/g, '');
const tgUser = site.contacts.telegram.replace(/^@/, '');

const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait/*.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;

const nextDate = next
  ? new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'en-GB', { day: 'numeric', month: 'long' })
      .format(new Date(`${next.date}T12:00:00`))
  : '';
---
<section class="section hero">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <div class="eyebrow">{t('hero.eyebrow')}</div>
      <h1 class="hero__name">{name}</h1>
      <p class="hero__tagline">{pick(site.tagline, lang)}</p>
      <p class="hero__lead">{pick(site.lead, lang)}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#lessons">{t('hero.ctaLessons')}</a>
        <a class="btn" href="#concerts">{t('hero.ctaConcerts')}</a>
      </div>
      {(waDigits || tgUser) && (
        <div class="hero__quick">
          <span>{t('hero.quick')}</span>
          {waDigits && (
            <a class="hero__msgr" href={`https://wa.me/${waDigits}?text=${quickMsg}`} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/></svg>
              WhatsApp
            </a>
          )}
          {tgUser && (
            <a class="hero__msgr" href={`https://t.me/${tgUser}?text=${quickMsg}`} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.8-3.6-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2L6.5 13.1 1.8 11.6c-1-.3-1-1 .2-1.5l18.5-7.1c.9-.3 1.6.2 1.4 1.3Z"/></svg>
              Telegram
            </a>
          )}
        </div>
      )}
      {next && (
        <a class="hero__next" href="#concerts" data-hero-next={next.date}>
          <span class="eyebrow hero__next-label"><span class="hero__dot" aria-hidden="true"></span>{t('hero.next')}</span>
          <span><strong>{nextDate}</strong> · {next.city}, {next.venue}</span>
        </a>
      )}
    </div>

    <div class="hero__portrait">
      {portrait ? (
        <Image
          src={portrait}
          alt={name}
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 820px) 100vw, 45vw"
          loading="eager"
          fetchpriority="high"
        />
      ) : demoPortrait ? (
        <img
          src={unsplashUrl(demoPortrait.id, 960)}
          srcset={unsplashSrcset(demoPortrait.id, [480, 720, 960, 1280])}
          sizes="(max-width: 820px) 100vw, 45vw"
          alt={name}
          fetchpriority="high"
        />
      ) : (
        <div class="hero__placeholder" role="img" aria-label={name}>
          <svg viewBox="0 0 100 220" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M50 4v58" /><rect x="45" y="2" width="10" height="16" rx="5" />
            <path d="M50 62c-16 0-26 10-26 24 0 9 6 14 6 20s-10 12-10 30c0 26 16 44 30 44s30-18 30-44c0-18-10-24-10-30s6-11 6-20c0-14-10-24-26-24z" />
            <path d="M38 118c-4 6-4 12 0 18M62 118c4 6 4 12 0 18" /><path d="M42 160h16" /><path d="M47 62v98M53 62v98" />
          </svg>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  // Сайт пересобирается не каждый день: если «ближайший» концерт уже прошёл — прячем строку.
  const nextLink = document.querySelector<HTMLElement>('[data-hero-next]');
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Moscow' }).format(new Date());
  if (nextLink && (nextLink.dataset.heroNext ?? '') < today) nextLink.hidden = true;
</script>

<style>
  .hero { padding-block: 56px 72px; }
  .hero__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; }
  .hero__text { min-width: 0; }
  /* Имя — главный заголовок: крупнее и в акцентном цвете; фраза — подзаголовок */
  .hero__name {
    margin-top: 16px;
    font-size: clamp(48px, 7.6vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--accent);
  }
  .hero__tagline {
    margin-top: 14px;
    font-family: var(--display);
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.2;
    text-wrap: balance;
  }
  .hero__lead { font-size: 19px; color: var(--muted); max-width: 32ch; margin-top: 20px; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__quick { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-top: 18px; font-size: 15px; color: var(--muted); }
  .hero__msgr {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--line); color: var(--ink); text-decoration: none; font-size: 15px;
  }
  .hero__msgr:hover { background: var(--soft); }
  .hero__msgr svg { width: 18px; height: 18px; color: var(--accent); }
  .hero__next {
    margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline;
    font-size: 15px; text-decoration: none;
  }
  .hero__next[hidden] { display: none; }
  .hero__next strong { font-weight: 500; }
  .hero__next-label { display: inline-flex; align-items: center; gap: 10px; }
  /* Пульсирующая точка привлекает внимание к ближайшему концерту. Без анимации — просто точка. */
  .hero__dot {
    position: relative; flex: none; width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
  }
  .hero__dot::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    background: var(--accent); animation: hero-pulse 2s ease-out infinite;
  }
  @keyframes hero-pulse {
    from { transform: scale(1); opacity: 0.6; }
    to { transform: scale(3); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__dot::after { animation: none; opacity: 0; } }
  .hero__next:hover span:last-child { text-decoration: underline; text-underline-offset: 3px; }

  .hero__portrait { aspect-ratio: 4 / 5; max-width: 100%; border-radius: 4px; overflow: hidden; background: var(--soft); border: 1px solid var(--line); }
  /* Лицо на портрете — в верхней трети: при обрезке до 4:5 и 4:3 держим его и скрипку в кадре */
  .hero__portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .hero__placeholder { width: 100%; height: 100%; display: grid; place-items: center; color: var(--muted); }
  .hero__placeholder svg { width: 40%; height: auto; opacity: 0.5; }

  @media (max-width: 820px) {
    .hero { padding-block: 40px 56px; }
    /* На телефоне портрет небольшой и стоит рядом с именем, остальной текст — ниже на всю ширину.
       .hero__text «растворяется», и его строки становятся ячейками общей сетки. */
    .hero__grid { grid-template-columns: minmax(0, 1fr) auto; gap: 0 16px; align-items: center; }
    .hero__text { display: contents; }
    .hero__text > * { grid-column: 1 / -1; }
    .hero__text > .hero__name { grid-column: 1; grid-row: 2; font-size: clamp(34px, 10.5vw, 64px); }
    .hero__portrait { grid-column: 2; grid-row: 2; width: min(36vw, 220px); margin-top: 16px; }
    .hero__lead { font-size: 17px; }
  }
</style>
