---
// Отзывы учеников: до трёх колонок, цитаты шрифтом с засечками.
// TODO (этап 7): JSON-LD Review.
import { type Lang, useTranslations, pick } from '../i18n/ui';
import reviews from '../data/reviews.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const quote = (s: string) => (lang === 'ru' ? `«${s}»` : `“${s}”`);
---
{reviews.items.length > 0 && (
  <section class="section" id="reviews">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">{t('reviews.eyebrow')}</div>
        <h2>{t('reviews.title')}</h2>
      </div>
      <div class="reviews">
        {reviews.items.map((r) => (
          <figure class="review">
            <blockquote><p>{quote(pick(r.text, lang))}</p></blockquote>
            <figcaption>{pick(r.author, lang)}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .reviews { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .review { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .review blockquote { margin: 0; }
  .review p { font-family: var(--display); font-size: 19px; line-height: 1.45; }
  .review figcaption { font-size: 14px; color: var(--muted); }
  @media (max-width: 820px) {
    .reviews { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
