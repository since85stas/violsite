---
import '@fontsource/prata/400.css';
import '@fontsource/golos-text/400.css';
import '@fontsource/golos-text/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, localizePath, pick } from '../i18n/ui';
import site from '../data/site.json';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
  /** Путь страницы без языкового префикса: '/', '/privacy' */
  path: string;
  title?: string;
  description?: string;
}

const { lang, path, title, description } = Astro.props;
const pageTitle = title ?? pick(site.seo.title, lang);
const pageDescription = description ?? pick(site.seo.description, lang);
const canonical = new URL(localizePath(path, lang), Astro.site);
const altRu = new URL(localizePath(path, 'ru'), Astro.site);
const altEn = new URL(localizePath(path, 'en'), Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={altRu} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altRu} />
    <!-- PNG — для Safari и сниппетов Яндекса; SVG (меняет цвета под тему) — для остальных браузеров -->
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={pick(site.name, lang)} />
    <meta property="og:image" content={new URL(withBase('/og-image.jpg'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pick(site.name, lang)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151311" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />

    <slot name="head" />

    <!-- «Живая афиша»: заголовки плавно выплывают при прокрутке (стили — global.css, .reveal).
         Встроено в head, чтобы скрыть заголовки до первой отрисовки и не мигать.
         Без JS, без IntersectionObserver или при «уменьшить движение» — всё видно сразу. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('reveal-on');
        document.addEventListener('DOMContentLoaded', () => {
          // Группы: надпись над заголовком → заголовок → подзаголовок, с небольшой задержкой друг за другом
          const groups = [
            ['.hero .eyebrow', '.hero__name', '.hero__tagline'],
            ...Array.from(document.querySelectorAll('main .section h2')).map((h2) => {
              const eyebrow = h2.previousElementSibling;
              return eyebrow && eyebrow.classList.contains('eyebrow') ? [eyebrow, h2] : [h2];
            }),
          ];
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }, { rootMargin: '0px 0px -8% 0px' });
          for (const group of groups) {
            group.forEach((item, i) => {
              const el = typeof item === 'string' ? document.querySelector(item) : item;
              if (!el || el.classList.contains('reveal')) return;
              el.classList.add('reveal');
              el.style.setProperty('--reveal-delay', `${i * 0.12}s`);
              io.observe(el);
            });
          }
          // Подстраховка: если что-то пошло не так, через 4 с показываем всё, что уже на экране и выше
          setTimeout(() => document.querySelectorAll('.reveal:not(.is-in)').forEach((el) => {
            if (el.getBoundingClientRect().top < innerHeight) el.classList.add('is-in');
          }), 4000);
        });
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} path={path} />
    <main id="top">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
