---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---
<Base lang="ru" path="/404" title="Страница не найдена">
  <section class="section">
    <div class="wrap">
      <h1>Страница не найдена</h1>
      <p class="muted">Page not found.</p>
      <p><a class="btn" href={withBase('/')}>На главную</a> <a class="btn" href={withBase('/en/')}>Home (English)</a></p>
    </div>
  </section>
</Base>
